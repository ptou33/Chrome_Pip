{
  "manifest_version": 3,
  "name": "Floating Video PiP",
  "version": "1.0.0",
  "description": "Porta il video corrente in una finestra flottante senza bordi con controlli per volume e riproduzione successiva.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Apri video flottante"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
